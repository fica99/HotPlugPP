set(GUI_CMAKE_FILE "@CMAKE_SOURCE_DIR@/examples/gui_host_app/CMakeLists.txt")

if(NOT EXISTS "${GUI_CMAKE_FILE}")
    message(FATAL_ERROR "Missing GUI example CMakeLists.txt: ${GUI_CMAKE_FILE}")
endif()

file(READ "${GUI_CMAKE_FILE}" GUI_CMAKE_CONTENT)

foreach(REQUIRED_SNIPPET
    "HOTPLUGPP_IMGUI_DIR is not set"
    "Skipping gui_host_app"
    "return()"
)
    string(FIND "${GUI_CMAKE_CONTENT}" "${REQUIRED_SNIPPET}" MATCH_INDEX)
    if(MATCH_INDEX EQUAL -1)
        message(FATAL_ERROR
            "GUI example CMakeLists.txt is missing required skip-contract snippet: ${REQUIRED_SNIPPET}\n"
            "Expected the file to contain graceful-skip logic when HOTPLUGPP_IMGUI_DIR is not set."
        )
    endif()
endforeach()
