set(readme_path "${PROJECT_SOURCE_DIR}/README.md")

if(NOT EXISTS "${readme_path}")
    message(FATAL_ERROR "Missing README file: ${readme_path}")
endif()

file(READ "${readme_path}" readme_content)

set(required_snippets
    "HOTPLUGPP_BUILD_GUI_EXAMPLE"
    "gui_host_app"
    "non-terminal"
)

foreach(required_snippet IN LISTS required_snippets)
    string(FIND "${readme_content}" "${required_snippet}" snippet_index)
    if(snippet_index EQUAL -1)
        message(FATAL_ERROR
            "README is missing required GUI example documentation text: ${required_snippet}"
