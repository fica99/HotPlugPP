set(BUILD_DIR "@CMAKE_BINARY_DIR@")
set(GUI_HOST_APP_NAME "gui_host_app@CMAKE_EXECUTABLE_SUFFIX@")
set(SAMPLE_PLUGIN_NAME "@CMAKE_SHARED_LIBRARY_PREFIX@sample_plugin@CMAKE_SHARED_LIBRARY_SUFFIX@")

function(require_any_path LABEL)
    foreach(CANDIDATE IN LISTS ARGN)
        if(EXISTS "${CANDIDATE}")
            return()
        endif()
    endforeach()

    string(REPLACE ";" "\n  " FORMATTED_CANDIDATES "${ARGN}")
    message(FATAL_ERROR
        "${LABEL} was not found in any expected location:\n  ${FORMATTED_CANDIDATES}"
    )
endfunction()

require_any_path(
    "gui_host_app executable"
    "${BUILD_DIR}/bin/Release/${GUI_HOST_APP_NAME}"
    "${BUILD_DIR}/bin/RelWithDebInfo/${GUI_HOST_APP_NAME}"
    "${BUILD_DIR}/bin/MinSizeRel/${GUI_HOST_APP_NAME}"
    "${BUILD_DIR}/bin/Debug/${GUI_HOST_APP_NAME}"
    "${BUILD_DIR}/bin/${GUI_HOST_APP_NAME}"
)

require_any_path(
    "sample_plugin library"
    "${BUILD_DIR}/bin/Release/${SAMPLE_PLUGIN_NAME}"
    "${BUILD_DIR}/bin/RelWithDebInfo/${SAMPLE_PLUGIN_NAME}"
    "${BUILD_DIR}/bin/MinSizeRel/${SAMPLE_PLUGIN_NAME}"
    "${BUILD_DIR}/bin/Debug/${SAMPLE_PLUGIN_NAME}"
    "${BUILD_DIR}/bin/${SAMPLE_PLUGIN_NAME}"
)
